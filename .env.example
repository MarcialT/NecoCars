# Copia este archivo a .env.local y rellena los valores.
# Solo las variables con prefijo VITE_ llegan al navegador: nunca pongas secretos aquí.

# Dominio público del sitio. Se usa al compilar para canonical, Open Graph,
# datos estructurados, robots.txt y sitemap.xml (única fuente del dominio).
VITE_SITE_URL=https://necocars.com
